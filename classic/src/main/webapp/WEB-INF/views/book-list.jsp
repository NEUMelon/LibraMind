<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/head.jspf" %>
<div class="page-heading"><h1>图书管理</h1></div>
<section class="panel"><form autocomplete="off" class="filters" method="get" action="${ctx}/app"><input type="hidden" name="module" value="books"><div class="filter-field"><label for="books-query">查询条件</label><input id="books-query" name="q" value="<c:out value='${param.q}'/>" placeholder="书号 / 书名 / 作者" maxlength="120" aria-label="搜索图书"></div><div class="filter-field"><label for="books-state">状态</label><select id="books-state" name="state" aria-label="馆藏状态"><option value="">全部状态</option><option value="AVAILABLE" ${param.state=='AVAILABLE'?'selected':''}>可借</option><option value="BORROWED" ${param.state=='BORROWED'?'selected':''}>在借</option><option value="OFF_SHELF" ${param.state=='OFF_SHELF'?'selected':''}>已下架</option></select></div><button class="button primary">查询</button><a class="button secondary" href="${ctx}/app?module=books">重置</a></form>
<div class="list-toolbar"><h2>图书列表</h2><a class="button primary" href="${ctx}/app?module=books&action=new"><svg aria-hidden="true"><use href="${ctx}/assets/icons.svg#plus"/></svg>新增图书</a></div>
<div class="table-wrap" role="region" aria-label="数据列表，可横向滚动" tabindex="0"><table class="book-table"><thead><tr><th scope="col">书号</th><th scope="col">书名</th><th scope="col">作者</th><th scope="col">版本号</th><th scope="col">状态</th><th scope="col" class="action-column">操作</th></tr></thead><tbody><c:forEach items="${page.items}" var="row"><tr><td class="mono nowrap"><c:out value="${row.bookNo}"/></td><td class="book-title"><c:url var="detailUrl" value="/app"><c:param name="module" value="books"/><c:param name="action" value="detail"/><c:param name="id" value="${row.id}"/><c:param name="q" value="${param.q}"/><c:param name="state" value="${param.state}"/><c:param name="page" value="${page.number}"/></c:url><a href="<c:out value='${detailUrl}'/>"><c:out value="${row.title}"/></a></td><td class="author-cell"><c:out value="${row.author}"/></td><td><c:out value="${row.edition}"/></td><td><span class="badge ${row.status.name()=='AVAILABLE'?'green':row.status.name()=='BORROWED'?'amber':'gray'}">${row.status.name()=='AVAILABLE'?'可借':row.status.name()=='BORROWED'?'在借':'已下架'}</span></td><td><div class="row-actions"><c:if test="${row.status.name()=='AVAILABLE'}"><c:url var="borrowUrl" value="/app"><c:param name="module" value="loans"/><c:param name="action" value="new"/><c:param name="bookNo" value="${row.bookNo}"/></c:url><a href="<c:out value='${borrowUrl}'/>">借阅</a></c:if><a href="${ctx}/app?module=books&action=edit&id=${row.id}">编辑</a><form autocomplete="off" method="post" action="${ctx}/app" data-confirm="确认删除书号 <c:out value='${row.bookNo}'/>《<c:out value='${row.title}'/>》？有历史借阅时将下架保留；在借图书不能删除。"><input type="hidden" name="module" value="books"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${row.id}"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="link-danger">删除</button></form></div></td></tr></c:forEach><c:if test="${empty page.items}"><tr><td colspan="6"><div class="empty"><h3>这里还没有匹配的图书</h3><p>调整关键词或状态筛选，也可以添加新馆藏。</p><a class="button secondary" href="${ctx}/app?module=books&action=new">新增图书</a></div></td></tr></c:if></tbody></table></div><%@ include file="common/pagination.jspf" %></section>
<%@ include file="common/foot.jspf" %>
