<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/head.jspf" %>
<c:set var="operationTitle" value="${operation=='return'?'确认归还':operation=='undo'?'撤销误归还':operation=='cancel'?'作废误登记':operation=='correctBorrow'?'更正借阅日期':'更正归还日期'}"/>
<c:set var="submitAction" value="${operation=='correctBorrow'||operation=='correctReturn'?'correct':operation}"/>
<div class="form-page"><div class="page-heading"><h1>${operationTitle}</h1><a class="button secondary" href="${ctx}/app?module=${module}">返回列表</a></div><div class="form-layout"><section class="panel form-panel"><div class="section-heading"><h2>记录信息</h2><span class="badge ${loan.status.name()=='ACTIVE'?'amber':loan.status.name()=='RETURNED'?'green':'gray'}">${loan.status.name()=='ACTIVE'?'在借':loan.status.name()=='RETURNED'?'已归还':'已作废'}</span></div><dl class="record-summary"><div><dt>学生</dt><dd><c:out value="${loan.studentName}"/> <span class="mono"><c:out value="${loan.studentNo}"/></span></dd></div><div><dt>图书</dt><dd><c:out value="${loan.bookTitle}"/> <span class="mono"><c:out value="${loan.bookNo}"/></span></dd></div><div><dt>借阅日期</dt><dd class="mono"><c:out value="${loan.borrowedText}"/></dd></div><div><dt>归还日期</dt><dd class="mono"><c:out value="${loan.returnedText}"/></dd></div></dl><form autocomplete="off" method="post" action="${ctx}/app" class="record-form" ${operation=='cancel'||operation=='undo'?'data-danger="true"':''}><input type="hidden" name="module" value="${module}"><input type="hidden" name="action" value="${submitAction}"><input type="hidden" name="id" value="${loan.id}"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><c:if test="${operation!='cancel'&&operation!='undo'}"><div class="field"><label for="at">${operation=='correctBorrow'?'更正为借阅日期':operation=='correctReturn'?'更正为归还日期':'实际归还日期'} <em>*</em></label><input type="datetime-local" id="at" name="at" value="<c:out value='${v.at}'/>" required></div></c:if><div class="field"><label for="reason">${operation=='return'?'备注（选填）':'操作原因 *'}</label><textarea id="reason" name="reason" maxlength="300" rows="3" ${operation!='return'?'required':''} placeholder="${operation=='return'?'如有需要，可补充归还情况':'请说明更正、作废或撤销的原因'}"><c:out value="${v.reason}"/></textarea></div><div class="inline-note ${operation=='undo'||operation=='cancel'?'warning':''}"><svg aria-hidden="true"><use href="${ctx}/assets/icons.svg#info"/></svg><c:choose><c:when test="${operation=='undo'}">撤销后恢复为在借。仅当图书仍可借，且没有后续借阅时才能撤销。</c:when><c:when test="${operation=='cancel'}">作废后保留记录与原因。在借图书将恢复可借；已归还图书的当前状态不变。</c:when><c:when test="${operation=='return'}">归还后，这册图书将恢复可借。</c:when><c:otherwise>请按实际办理时间更正，不能与前后借阅记录重叠。</c:otherwise></c:choose></div><c:if test="${not empty loan.note}"><details class="history-note"><summary>已有备注与更正记录</summary><p><c:out value="${loan.note}"/></p></details></c:if><div class="form-actions"><a class="button secondary" href="${ctx}/app?module=${module}">取消</a><button class="button ${operation=='undo'||operation=='cancel'?'danger':'primary'}">${operationTitle}</button></div></form></section></div>
</div>
<%@ include file="common/foot.jspf" %>
