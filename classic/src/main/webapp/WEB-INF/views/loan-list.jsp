<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/head.jspf" %><c:set var="isReturn" value="${module=='returns'}"/>
<div class="page-heading"><h1>${isReturn?'还书记录':'借书记录'}</h1></div>
<c:if test="${not empty param.studentNo}"><div class="filter-context">仅显示学号 <strong><c:out value="${param.studentNo}"/></strong> 的记录。<a class="text-link" href="${ctx}/app?module=loans">查看所有学生</a></div></c:if>
<section class="panel"><form autocomplete="off" class="filters record-filters" method="get" action="${ctx}/app"><input type="hidden" name="module" value="${module}"><input spellcheck="false" type="hidden" name="studentNo" value="<c:out value='${param.studentNo}'/>"><div class="filter-field"><label for="loan-query">查询条件</label><input id="loan-query" name="q" aria-label="搜索借还记录" value="<c:out value='${param.q}'/>" placeholder="学号、姓名、书号或书名" maxlength="120"></div><c:if test="${!isReturn}"><div class="filter-field"><label for="loan-state">状态</label><select id="loan-state" name="state" aria-label="借阅状态"><option value="">全部有效记录</option><option value="ACTIVE" ${param.state=='ACTIVE'?'selected':''}>在借</option><option value="RETURNED" ${param.state=='RETURNED'?'selected':''}>已归还</option><option value="CANCELLED" ${param.state=='CANCELLED'?'selected':''}>已作废</option></select></div></c:if><div class="filter-field date-filter"><label for="from">${isReturn?'归还日期':'借阅日期'}</label><input id="from" type="date" name="from" value="<c:out value='${param.from}'/>"><span>至</span><input type="date" name="to" aria-label="结束日期" value="<c:out value='${param.to}'/>"></div><button class="button primary">查询</button><a class="button secondary" href="${ctx}/app?module=${module}">重置</a></form>
<div class="list-toolbar"><h2>${isReturn?'归还记录列表':'借阅记录列表'}</h2><a class="button primary" href="${ctx}/app?module=${module}&action=new">${isReturn?'登记归还':'登记借阅'}</a></div>
<div class="table-wrap" role="region" aria-label="数据列表，可横向滚动" tabindex="0"><table class="loan-table"><thead><tr><th scope="col">编号</th><th scope="col">学号</th><th scope="col">姓名</th><th scope="col">图书 / 书号</th><th scope="col">借阅日期</th><th scope="col">归还日期</th><th scope="col">状态</th><th scope="col" class="action-column">操作</th></tr></thead><tbody><c:forEach items="${page.items}" var="row"><tr><td class="number-cell">${row.id}</td><td class="mono nowrap"><c:out value="${row.studentNo}"/></td><td class="nowrap"><c:out value="${row.studentName}"/></td><td class="title-cell"><strong><c:out value="${row.bookTitle}"/></strong><small class="sub mono"><c:out value="${row.bookNo}"/></small></td><td class="mono date-cell"><c:out value="${row.borrowedText}"/></td><td class="mono date-cell ${row.status.name()=='ACTIVE'?'muted':''}"><c:out value="${row.returnedText}"/></td><td><span class="badge ${row.status.name()=='ACTIVE'?'amber':row.status.name()=='RETURNED'?'green':'gray'}">${row.status.name()=='ACTIVE'?'在借':row.status.name()=='RETURNED'?'已归还':'已作废'}</span></td><td><div class="row-actions"><c:choose><c:when test="${isReturn}"><a href="${ctx}/app?module=returns&action=edit&id=${row.id}">更正日期</a><a class="danger-text" href="${ctx}/app?module=returns&action=undoForm&id=${row.id}">撤销归还</a></c:when><c:when test="${row.status.name()!='CANCELLED'}"><c:if test="${row.status.name()=='ACTIVE'}"><a href="${ctx}/app?module=returns&action=confirm&id=${row.id}">归还</a></c:if><a href="${ctx}/app?module=loans&action=edit&id=${row.id}">更正</a><a class="danger-text" href="${ctx}/app?module=loans&action=cancelForm&id=${row.id}">作废</a></c:when><c:otherwise><span class="muted">已作废</span></c:otherwise></c:choose></div><c:if test="${not empty row.note}"><details class="record-note"><summary>查看备注</summary><p><c:out value="${row.note}"/></p></details></c:if></td></tr></c:forEach><c:if test="${empty page.items}"><tr><td colspan="8"><div class="empty"><svg aria-hidden="true"><use href="${ctx}/assets/icons.svg#${isReturn?'in':'out'}"/></svg><h3>${isReturn?'还没有匹配的归还记录':'还没有匹配的借阅记录'}</h3><p>调整筛选条件，或登记一次${isReturn?'归还':'借阅'}。</p><a class="button secondary" href="${ctx}/app?module=${module}&action=new">${isReturn?'登记归还':'登记借阅'}</a></div></td></tr></c:if></tbody></table></div><%@ include file="common/pagination.jspf" %></section>
<%@ include file="common/foot.jspf" %>
