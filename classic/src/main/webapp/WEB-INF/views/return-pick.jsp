<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/head.jspf" %>
<a class="back-link" href="${ctx}/app?module=returns">← 返回还书记录</a><div class="page-heading"><h1>登记归还</h1><span class="step-label">选择记录 / 确认归还</span></div><section class="panel"><form autocomplete="off" class="filters" method="get" action="${ctx}/app"><input type="hidden" name="module" value="returns"><input type="hidden" name="action" value="new"><div class="filter-field"><label for="return-query">查询条件</label><input id="return-query" name="q" value="<c:out value='${param.q}'/>" placeholder="输入学号、姓名、书号或书名" aria-label="查找在借记录"></div><button class="button primary">查找在借记录</button><a class="button secondary" href="${ctx}/app?module=returns&action=new">重置</a></form><div class="list-toolbar"><h2>在借图书列表</h2></div><div class="table-wrap" role="region" aria-label="数据列表，可横向滚动" tabindex="0"><table class="return-table"><thead><tr><th scope="col">学生 / 学号</th><th scope="col">图书 / 书号</th><th scope="col">借阅日期</th><th scope="col">状态</th><th scope="col" class="align-right">操作</th></tr></thead><tbody><c:forEach items="${page.items}" var="row"><tr><td><strong><c:out value="${row.studentName}"/></strong><small class="sub mono"><c:out value="${row.studentNo}"/></small></td><td><strong><c:out value="${row.bookTitle}"/></strong><small class="sub mono"><c:out value="${row.bookNo}"/></small></td><td class="mono"><c:out value="${row.borrowedText}"/></td><td><span class="badge amber">在借</span></td><td class="align-right"><a class="button secondary small" href="${ctx}/app?module=returns&action=confirm&id=${row.id}">办理归还</a></td></tr></c:forEach><c:if test="${empty page.items}"><tr><td colspan="5"><div class="empty"><svg aria-hidden="true"><use href="${ctx}/assets/icons.svg#in"/></svg><h3>没有匹配的在借图书</h3><p>请检查关键词，已归还记录可在还书列表中查看。</p></div></td></tr></c:if></tbody></table></div><%@ include file="common/pagination.jspf" %></section>
<%@ include file="common/foot.jspf" %>
