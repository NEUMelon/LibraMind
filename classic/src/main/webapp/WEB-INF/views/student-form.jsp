<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/head.jspf" %>
<div class="form-page"><div class="page-heading"><h1>${empty v.id?'新增学生':'编辑学生'}</h1><a class="button secondary" href="${ctx}/app?module=students">返回列表</a></div><div class="form-layout"><section class="panel form-panel"><div class="section-heading"><h2>基本资料</h2><span class="muted">* 为必填项</span></div><form autocomplete="off" method="post" action="${ctx}/app" class="record-form"><input type="hidden" name="module" value="students"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="<c:out value='${v.id}'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}">
<div class="field"><label for="studentNo">学号 <em>*</em></label><input spellcheck="false" id="studentNo" inputmode="numeric" name="studentNo" value="<c:out value='${v.studentNo}'/>" required maxlength="32" pattern="[0-9]{1,32}" ${not empty v.id?'readonly':''}><small class="field-error" id="studentNo-error"><c:out value="${errors.studentNo}"/></small><small>学号只含数字，保存后不可更改。</small></div>
<div class="field"><label for="name">姓名 <em>*</em></label><input id="name" name="name" value="<c:out value='${v.name}'/>" required maxlength="80" placeholder="请输入学生姓名"><small class="field-error" id="name-error"><c:out value="${errors.name}"/></small></div><div class="form-row"><div class="field"><label for="college">学院 <em>*</em></label><input id="college" name="college" value="<c:out value='${v.college}'/>" required maxlength="120" placeholder="如：信息科学与工程学院"><small class="field-error" id="college-error"><c:out value="${errors.college}"/></small></div><div class="field"><label for="major">专业 <em>*</em></label><input id="major" name="major" value="<c:out value='${v.major}'/>" required maxlength="120" placeholder="如：自动化"><small class="field-error" id="major-error"><c:out value="${errors.major}"/></small></div></div>
<div class="field"><label for="borrowedCount">已借书数量</label><input type="number" id="borrowedCount" value="${empty borrowedCount ? 0 : borrowedCount}" readonly><small>由借阅、归还操作自动维护。</small></div>
<c:if test="${not empty v.id}"><div class="field"><label for="enabled">资料状态</label><select id="enabled" name="enabled"><option value="true" ${v.enabled=='true'?'selected':''}>已启用</option><option value="false" ${v.enabled=='false'?'selected':''}>已停用</option></select></div></c:if><div class="form-actions"><a class="button secondary" href="${ctx}/app?module=students">取消</a><button class="button primary">保存学生资料</button></div></form></section></div>
</div>
<%@ include file="common/foot.jspf" %>
