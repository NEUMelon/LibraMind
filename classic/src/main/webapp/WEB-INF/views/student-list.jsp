<%@ page pageEncoding="UTF-8" %>
<%@ include file="common/head.jspf" %>
<div class="page-heading"><h1>学生管理</h1></div>
<section class="panel"><form autocomplete="off" class="filters" method="get" action="${ctx}/app"><input type="hidden" name="module" value="students"><div class="filter-field"><label for="students-query">查询条件</label><input id="students-query" aria-label="搜索学生" name="q" value="<c:out value='${param.q}'/>" placeholder="学号 / 姓名 / 学院 / 专业" maxlength="120"></div><div class="filter-field"><label for="students-state">状态</label><select id="students-state" name="state" aria-label="学生状态"><option value="">全部状态</option><option value="enabled" ${param.state=='enabled'?'selected':''}>已启用</option><option value="disabled" ${param.state=='disabled'?'selected':''}>已停用</option></select></div><button class="button primary">查询</button><a class="button secondary" href="${ctx}/app?module=students">重置</a></form>
<div class="list-toolbar"><h2>学生列表</h2><a class="button primary" href="${ctx}/app?module=students&action=new"><svg aria-hidden="true"><use href="${ctx}/assets/icons.svg#plus"/></svg>新增学生</a></div>
<div class="table-wrap" role="region" aria-label="数据列表，可横向滚动" tabindex="0"><table class="student-table"><thead><tr><th scope="col">学号</th><th scope="col">姓名</th><th scope="col">学院</th><th scope="col">专业</th><th scope="col">已借书数量</th><th scope="col">状态</th><th scope="col" class="action-column">操作</th></tr></thead><tbody><c:forEach items="${page.items}" var="row"><tr><td class="mono nowrap"><c:out value="${row.studentNo}"/></td><td class="nowrap"><c:out value="${row.name}"/></td><td><c:out value="${row.college}"/></td><td><c:out value="${row.major}"/></td><td><c:url var="loanUrl" value="/app"><c:param name="module" value="loans"/><c:param name="state" value="ACTIVE"/><c:param name="studentNo" value="${row.studentNo}"/></c:url><a class="count-link" href="<c:out value='${loanUrl}'/>">${row.borrowedCount}<small>册</small></a></td><td><span class="badge ${row.enabled?'green':'gray'}">${row.enabled?'已启用':'已停用'}</span></td><td><div class="row-actions"><a href="${ctx}/app?module=students&action=edit&id=${row.id}">编辑</a><form autocomplete="off" method="post" action="${ctx}/app" data-confirm="确认删除学生 ${row.studentNo}（<c:out value='${row.name}'/>）？有借阅历史时将停用资料；仍有未归还图书时不能删除。"><input type="hidden" name="module" value="students"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${row.id}"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="link-danger">删除</button></form></div></td></tr></c:forEach><c:if test="${empty page.items}"><tr><td colspan="7"><div class="empty"><h3>没有找到学生资料</h3><p>试试其他关键词，或添加一位新学生。</p><a class="button secondary" href="${ctx}/app?module=students&action=new">新增学生</a></div></td></tr></c:if></tbody></table></div><%@ include file="common/pagination.jspf" %></section>
<%@ include file="common/foot.jspf" %>
